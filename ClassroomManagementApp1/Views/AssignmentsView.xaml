<Window x:Class="ClassroomManagementApp1.Views.AssignmentsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/iconpacks"
        xmlns:local="clr-namespace:ClassroomManagementApp1.Views"
        xmlns:component="clr-namespace:ClassroomManagementApp1.Component"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" 
        Title="AssignmentsDraft" Height="760" Width="1280" Background="Transparent" ResizeMode="NoResize">
    <Border Background="#f6eefb" CornerRadius="40" BorderThickness="2" BorderBrush = "#ebedf3"
        Padding="20" >
        <Border CornerRadius="40" Height="716" VerticalAlignment="Center" HorizontalAlignment="Right" Width="1236">
            <Grid Margin="0,0,0,15" HorizontalAlignment="Center" Width="1176" Height="686" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="4.2*"/>
                </Grid.ColumnDefinitions>
                
                <Border CornerRadius="20 0 0 20" ClipToBounds="True" Background="White" Grid.Row="0"  Grid.RowSpan="2">
                    <Border  CornerRadius="20 0 0 20" ClipToBounds="True" Margin="0,0,-5,0">
                        <Border.Background>
                            <SolidColorBrush Color="White"></SolidColorBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <Grid Grid.Column="0" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" >
                        <Image Source="/Image/logo.png" Stretch="Uniform" Width="130"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,100.7,0,0">
                        <Border CornerRadius="10" Padding="5,5,5,5" Margin="15,0,15,0" Width="162"  >
                            <Button x:Name="btnDashboard"  Style="{StaticResource menuButton}" Click="BtnDashboard_Click" Width="158" Margin="-5,5,0,5"  >
                                <Button.Triggers>
                                    <!-- Trigger khi di chuột vào Button -->
                                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Đổi màu nền của Button khi di chuột vào -->
                                                <ColorAnimation 
             Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)" 
             To="#ebdef2" Duration="0:0:0.2" />
                                                <!-- Đổi màu Foreground của TextBlock khi di chuột vào -->
                                                <ColorAnimation 
             Storyboard.TargetName="assignmentText" 
             Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
             To="Black" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- Trigger khi di chuột ra khỏi Button -->
                                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Trở lại màu nền gốc của Button khi di chuột ra -->
                                                <ColorAnimation 
             Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)" 
             To="Transparent" Duration="0:0:0.2" />
                                                <!-- Trở lại màu Foreground gốc của TextBlock khi di chuột ra -->
                                                <ColorAnimation 
             Storyboard.TargetName="assignmentText" 
             Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
             To="#959595" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Icon:PackIconMaterial Kind="HomeVariant" VerticalAlignment="Center" Foreground="#959595"/>
                                    <!-- Gán tên cho TextBlock để có thể sử dụng trong Storyboard -->
                                    <TextBlock x:Name="dashboardText" Text=" Dashboard" FontFamily="Montserrat Bold" FontSize="17" Foreground="#959595" VerticalAlignment="Center" Height="18" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Button>

                        </Border>
                        <Border Background="Transparent" Padding="5,5,5,5" Margin="15,0,15,0" Width="162"  >
                            <Button x:Name="btnClassroom" Style="{StaticResource menuButton}" Click="BtnClassroom_Click"  Width="158" Margin="-5,5,0,5" >
                                <Button.Triggers>
                                    <!-- Trigger khi di chuột vào Button -->
                                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Đổi màu nền của Button khi di chuột vào -->
                                                <ColorAnimation 
                                            Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)" 
                                            To="#ebdef2" Duration="0:0:0.2" />
                                                <!-- Đổi màu Foreground của TextBlock khi di chuột vào -->
                                                <ColorAnimation 
                                            Storyboard.TargetName="classroomText" 
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                            To="Black" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- Trigger khi di chuột ra khỏi Button -->
                                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Trở lại màu nền gốc của Button khi di chuột ra -->
                                                <ColorAnimation 
                                            Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)" 
                                            To="Transparent" Duration="0:0:0.2" />
                                                <!-- Trở lại màu Foreground gốc của TextBlock khi di chuột ra -->
                                                <ColorAnimation 
                                             Storyboard.TargetName="classroomText" 
                                             Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                             To="#959595" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Icon:PackIconMaterial Kind="School" VerticalAlignment="Center" Foreground="#959595"/>
                                    <TextBlock  x:Name="classroomText" Text=" Classroom" FontFamily="Montserrat Bold" FontSize="17" Foreground="#959595"
                                 VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border Background="Transparent" CornerRadius="10" Padding="5,5,5,5" Margin="15,0,15,0" Width="162"  >
                            <Button x:Name="btnAssignment" Style="{StaticResource menuButton}"  Width="158" Margin="-5,5,0,5" Background="#b897c6">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Icon:PackIconMaterial Kind="ClockCheck" VerticalAlignment="Center" Foreground="white"/>
                                    <TextBlock  x:Name="assignmentText"  Text="Assignment" FontFamily="Montserrat Bold" FontSize="17" Foreground="white"
                                 VerticalAlignment="Center" Margin="3,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border Background="Transparent" Padding="5,5,5,5" Margin="15,0,15,0" Width="162">
                            <Button x:Name="btnSetting"  Style="{StaticResource menuButton}"  Width="158" Margin="-5,5,0,5" Click="Setting_Click" >
                                <Button.Triggers>
                                    <!-- Trigger khi di chuột vào Button -->
                                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Đổi màu nền của Button khi di chuột vào -->
                                                <ColorAnimation 
                                            Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)" 
                                            To="#ebdef2" Duration="0:0:0.2" />
                                                <!-- Đổi màu Foreground của TextBlock khi di chuột vào -->
                                                <ColorAnimation 
                                            Storyboard.TargetName="settingText" 
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                            To="Black" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- Trigger khi di chuột ra khỏi Button -->
                                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Trở lại màu nền gốc của Button khi di chuột ra -->
                                                <ColorAnimation 
                                             Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)" 
                                            To="Transparent" Duration="0:0:0.2" />
                                                <!-- Trở lại màu Foreground gốc của TextBlock khi di chuột ra -->
                                                <ColorAnimation 
                                            Storyboard.TargetName="settingText" 
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                            To="#959595" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Icon:PackIconMaterial Kind="Cog"  VerticalAlignment="Center" Foreground="#959595"/>
                                    <TextBlock x:Name="settingText"  Text=" Setting" FontFamily="Montserrat Bold" FontSize="17" Foreground="#959595"
                                VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,80,0,0">
                        <Border>
                            <Button x:Name="btnLogout"  Style="{StaticResource menuButton}" Width="158" Click="SignOut_Click">
                                <Button.Triggers>
                                    <!-- Trigger khi di chuột vào Button -->
                                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Đổi màu nền của Button khi di chuột vào -->
                                                <ColorAnimation 
                                            Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)" 
                                            To="#ebdef2" Duration="0:0:0.2" />
                                                <!-- Đổi màu Foreground của TextBlock khi di chuột vào -->
                                                <ColorAnimation 
                                            Storyboard.TargetName="signoutText" 
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                            To="Black" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- Trigger khi di chuột ra khỏi Button -->
                                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Trở lại màu nền gốc của Button khi di chuột ra -->
                                                <ColorAnimation 
                                            Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)" 
                                            To="Transparent" Duration="0:0:0.2" />
                                                <!-- Trở lại màu Foreground gốc của TextBlock khi di chuột ra -->
                                                <ColorAnimation 
                                            Storyboard.TargetName="signoutText" 
                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" 
                                            To="#959595" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                                <StackPanel>
                                    <Icon:PackIconMaterial HorizontalAlignment="Center" Kind="ExitToApp" Foreground="Gray" />
                                    <TextBlock  x:Name="signoutText" Text="SIGN OUT" FontFamily="Montserrat" FontSize="17" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1">
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="white" Offset="0"/>
                                <GradientStop Color="#f6eefb" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="20" Background="#ebdef2"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="71"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock VerticalAlignment="Bottom" Margin="20,0,0,0" Text="Your Assignments:" Foreground="Gray" FontFamily="Montserrat" FontSize="32"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <component:AssigmentListViewAssignments/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>

