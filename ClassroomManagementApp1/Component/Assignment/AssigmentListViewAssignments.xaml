<UserControl x:Class="ClassroomManagementApp1.Component.AssigmentListViewAssignments"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassroomManagementApp1.Component"
        mc:Ignorable="d"
        Height="555" Width="927.84" Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="30,20,15,0">
            <ListView x:Name="FirstListView"
                      ItemsSource="{Binding FirstHalfAssignments}"
                      ScrollViewer.CanContentScroll="False"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden">

                <!-- Loại bỏ hiệu ứng khi di chuột qua mỗi item -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="20" Background="#ebdef2" Margin="5">
                            <Border x:Name="BoAssignment1" VerticalAlignment="Top" Background="White" CornerRadius="20">
                                <StackPanel Margin="30">
                                    <Border HorizontalAlignment="Left" Background="#b897c6" CornerRadius="15">
                                        <TextBlock Text="{Binding _assignmentname}" FontSize="35" FontFamily="Comic Sans MS" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,2"/>
                                    </Border>
                                    <Border Margin="20,18,20,0" BorderBrush="#b897c6" BorderThickness="0.5" CornerRadius="10">
                                        <Grid>
                                            <StackPanel Margin="10,5" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding _description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="300" FontSize="25" FontFamily="Montserrat" Foreground="Gray"/>
                                                <TextBlock Text="{Binding _duedate}" FontSize="20" FontFamily="Montserrate" Foreground="Gray" Margin="0,55,0,0"/>
                                                <Button x:Name="BtnSubmit1" Background="Transparent" BorderBrush="Transparent" Margin="0,6,0,6" Height="50">
                                                    <Border Background="#C7E4FF" BorderBrush="Transparent" HorizontalAlignment="Center" CornerRadius="20">
                                                        <TextBlock Text="Submit" Foreground="Gray" FontSize="20" FontFamily="Montserrate" HorizontalAlignment="Center" Margin="6"/>
                                                    </Border>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" Margin="15,20,30,0">
            <ListView x:Name="SecondListView"
                      ItemsSource="{Binding SecondHalfAssignments}"
                      ScrollViewer.CanContentScroll="False"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden">

                <!-- Loại bỏ hiệu ứng khi di chuột qua mỗi item -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="20" Background="#ebdef2" Margin="5">
                            <Border x:Name="BoAssignment1" VerticalAlignment="Top" Background="White" CornerRadius="20">
                                <StackPanel Margin="30">
                                    <Border HorizontalAlignment="Left" Background="#b897c6" CornerRadius="15">
                                        <TextBlock Text="{Binding _assignmentname}" FontSize="35" FontFamily="Comic Sans MS" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,2"/>
                                    </Border>
                                    <Border Margin="20,18,20,0" BorderBrush="#b897c6" BorderThickness="0.5" CornerRadius="10">
                                        <Grid>
                                            <StackPanel Margin="10,5" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding _description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="300" FontSize="25" FontFamily="Montserrat" Foreground="Gray"/>
                                                <TextBlock Text="{Binding _duedate}" FontSize="20" FontFamily="Montserrate" Foreground="Gray" Margin="0,55,0,0"/>
                                                <Button x:Name="BtnSubmit1" Background="Transparent" BorderBrush="Transparent" Margin="0,6,0,6" Height="50">
                                                    <Border Background="#C7E4FF" BorderBrush="Transparent" HorizontalAlignment="Center" CornerRadius="20">
                                                        <TextBlock Text="Submit" Foreground="Gray" FontSize="20" FontFamily="Montserrate" HorizontalAlignment="Center" Margin="6"/>
                                                    </Border>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
