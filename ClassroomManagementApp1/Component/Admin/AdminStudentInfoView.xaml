<UserControl x:Class="ClassroomManagementApp1.Component.AdminStudentInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClassroomManagementApp1.Component"
             mc:Ignorable="d" 
             d:DesignHeight="475" d:DesignWidth="1176">
    <Border Background="White" Margin="25,0,25,25" CornerRadius="20">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid x:Name="studentDataGrid" 
                  ItemsSource="{Binding Students}" 
                  AutoGenerateColumns="False" 
                  HeadersVisibility="Column" 
                  RowBackground="White" 
                  AlternatingRowBackground="#f2f2f2" 
                  BorderThickness="0" 
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#d3d3d3" 
                  VerticalGridLinesBrush="#d3d3d3"
                  MaxHeight="450"                   
                  SelectionChanged="studentDataGrid_SelectionChanged">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#b897d1" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontFamily" Value="Montserrat" />
                        <Setter Property="FontSize" Value="25" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="BorderBrush" Value="#d3d3d3" />
                        <!-- Màu viền giữa các header -->
                        <Setter Property="BorderThickness" Value="0.5" />
                        <!-- Viền cho các header -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header=" Student ID " 
                                    FontFamily="Montserrat" 
                                    FontSize="20" 
                                    Foreground="gray" 
                                    Binding="{Binding StudentId}" 
                                    Width="170"/>
                    <DataGridTextColumn Header=" Name " 
                                    FontFamily="Montserrat" 
                                    FontSize="20" 
                                    Foreground="gray" 
                                    Binding="{Binding StudentName}" 
                                    Width="350" />
                    <DataGridTextColumn Header=" Email " 
                                    FontFamily="Montserrat" 
                                    FontSize="20" 
                                    Foreground="gray" 
                                    Binding="{Binding Email}" 
                                    Width="486" />
                    <DataGridTextColumn Header=" Grade " 
                                    FontFamily="Montserrat" 
                                    FontSize="20" 
                                    Foreground="gray" 
                                    Binding="{Binding StudentGrade}" 
                                    Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Border>
</UserControl>
