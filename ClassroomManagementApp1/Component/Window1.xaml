<UserControl x:Class="ClassroomManagementApp1.Component.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassroomManagementApp1.Component"
        mc:Ignorable="d"
         Height="450" Width="800">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ListView ItemsSource="{Binding SubmissonAssignments}" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <Border Background="White" CornerRadius="0,20,20,0" Grid.Column="1"/>
                    <Border CornerRadius="30,0,0,30" Background="#ebdef2" Grid.Column="1"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5.5*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="6*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row ="0">
                                    <Image Source="/Image/background.png" HorizontalAlignment="Left" Margin="50,15,0,0" Width="220" />
                                <TextBlock Text="English" FontSize="40" FontFamily="Comic Sans MS" FontWeight="Bold" FontStyle="Italic" Foreground="#b897c6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="85,15,0,0"/>
                            </Grid>
                            <Grid Grid.Row ="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="White" CornerRadius="30" Grid.RowSpan="4" Margin="30,15,30,0"></Border>
                                <Grid Grid.Row ="0">
                                    <TextBlock Text="Lesson 1: Travelling" FontSize="20" FontFamily="Montserrat Bold" Foreground="Gray" Margin="70,30,0,0"/>
                                </Grid>
                                <Grid Grid.Row ="1">
                                    <Border Background="#b897c6" CornerRadius="20" Margin="70,15,0,3" HorizontalAlignment="Left" Width="126">
                                        <TextBlock Text="Materials" FontFamily="Montserrat" Foreground="White" HorizontalAlignment="Center" FontSize="20"/>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Border Background="#b897c6" CornerRadius="20" Margin="70,60,0,3" HorizontalAlignment="Left" Width="151">
                                        <TextBlock Text="Assignments" FontFamily="Montserrat" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,15,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="#b897c6" BorderThickness="0.5" CornerRadius="10" Margin="70,0,50,0" Grid.ColumnSpan="3">
                                        <TextBlock Text="EX1: " FontSize="25" FontFamily="Montserrat" Foreground="Gray" VerticalAlignment="Center" Margin="30,0,0,0"/>
                                    </Border>
                                    <Grid Grid.Column="2" Margin="0,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#ed8890" BorderBrush="Transparent" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                                            <Button >
                                                <TextBlock Text="Submit" Foreground="Gray" FontSize="20" FontFamily="Montserrat" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Border>
                                        <Grid Grid.Row="1">
                                            <TextBlock Text="Thursday, October 3rd" FontSize="20" FontFamily="Montserrat" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
    </ScrollViewer>
</UserControl>
