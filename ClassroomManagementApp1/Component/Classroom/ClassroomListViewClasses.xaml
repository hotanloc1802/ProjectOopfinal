<UserControl x:Class="ClassroomManagementApp1.Component.Classroom.ClassroomListViewClasses"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassroomManagementApp1.Component.Classroom"
        xmlns:convert="clr-namespace:ClassroomManagementApp1.ValueConverter"
        mc:Ignorable="d"
        Height="450" Width="800">
    <UserControl.Resources>
        <convert:MainWindowBoxClassesDateConverter x:Key="MainWindowBoxClassesDateConverter" />
    </UserControl.Resources>
    <Grid>
        <ListView ItemsSource="{Binding ListClassesWithDateRange}" ScrollViewer.VerticalScrollBarVisibility="Visible"
          ScrollViewer.CanContentScroll="False"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Grid Background="{TemplateBinding Background}">
                                    <ContentPresenter />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Button x:Name="BtnClassroom4" Background="Transparent"  Height="200" BorderBrush="Transparent" Click="BtnClassroom1_Click" CommandParameter="{Binding classid}"  >
                        <Border Margin="20,0,0,0" Height="170" Width="689" CornerRadius="20" Background="#b897c6">
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" MinWidth="100"/>
                                    <ColumnDefinition Width="Auto" MinWidth="369.5"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="30,0,0,0">
                                    <Grid Width="120" Height="120" Margin="0,10,0,0">
                                        <Ellipse Width="110" Height="110" Fill="#f6eefb" Stroke="Transparent"/>
                                        <Image Source="/Image/2.png" Width="100" Stretch="UniformToFill" Height="100">
                                            <Image.Clip>
                                                <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                    <TextBlock Text="{Binding teachername}" FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="15,0,0,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0">
                                        <TextBlock Text="{Binding classname}" FontSize="34" FontFamily="Montserrat Bold" Foreground="White" />
                                        <TextBlock Text="{Binding DateRange, Converter={StaticResource MainWindowBoxClassesDateConverter}}" FontSize="18" FontFamily="Montserrat" Foreground="White" Margin="0,2,0,0"/>
                                        <Border Margin="0,2,0,0" Background="#ED5757" CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center" Text="{Binding AssignmentCount, StringFormat='{}{0} assignments updated'}"  FontSize="18" FontFamily="Montserrat" Foreground="white" Margin="5,0"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Button>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>